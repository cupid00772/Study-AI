{
  "name": "task-commander",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Cupid",
  "description": "Task Commander - NCU Academic Dashboard, Alert Engine & Desktop Productivity Suite",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder --win dir",
    "electron:preview": "vite build && electron .",
    "deploy": "node scripts/deploy.cjs",
    "build:installer": "vite build && electron-builder --win nsis",
    "push": "node scripts/push.cjs",
    "sync:assets": "node scripts/sync-cloud-assets.cjs",
    "sync:assets:dry": "node scripts/sync-cloud-assets.cjs --dry-run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.42.0",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.1.2",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.cupid.task-commander",
    "productName": "Task Commander",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/icon.ico",
      "public/icon.png",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Task Commander",
      "artifactName": "TaskCommander-Setup-${version}.exe"
    }
  }
}
