{
  "name": "task-commander",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Cupid",
  "description": "Task Commander - Gamified Task Management Desktop App",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder --win",
    "electron:preview": "vite build && electron ."
  },
  "dependencies": {
    "katex": "^0.19.1",
    "lucide-react": "^1.42.0",
    "marked": "^18.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.1.2",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "electron-squirrel-startup": "^1.0.1",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.cupid.task-commander",
    "productName": "Task Commander",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.svg"
    },
    "portable": {
      "artifactName": "TaskCommander.exe"
    }
  }
}
